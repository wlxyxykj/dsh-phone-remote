{
  "name": "dsh-phone-remote",
  "version": "1.0.0",
  "description": "Phone control for DeepSeek Harness: a token-protected mobile page served from this computer, with an optional IP allowlist, so you can drive the agent from your phone — list sessions, send prompts, watch live output, cancel a turn. 手机遥控：打开链接/扫码即可在手机上指挥电脑上的 DSH Agent 干活，支持 IP 白名单与 Tailscale。",
  "license": "MIT",
  "author": "tofar",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "mobile",
    "phone",
    "remote",
    "remote-control",
    "lan",
    "tailscale",
    "手机遥控"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wlxyxykj/dsh-phone-remote.git"
  },
  "homepage": "https://github.com/wlxyxykj/dsh-phone-remote#readme",
  "bugs": {
    "url": "https://github.com/wlxyxykj/dsh-phone-remote/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
